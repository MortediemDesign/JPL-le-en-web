# SMTP pro odesílání poptávek (povinné v produkci)
SMTP_HOST=smtp.example.cz
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Web J.P.L. LEŠENÍ <web@jplleseni.cz>"

# Kam jde poptávka, když není vybráno středisko (výchozí info@jplleseni.cz)
INQUIRY_TO_DEFAULT=info@jplleseni.cz
# Volitelná kopie všech poptávek
INQUIRY_CC=

# Volitelně Cloudflare Turnstile (neviditelná anti-spam ochrana)
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Server
PORT=4321
CANONICAL_HOST=www.jplleseni.cz
FORCE_HTTPS=1
