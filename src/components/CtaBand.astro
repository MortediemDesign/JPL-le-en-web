---
import { company, telHref } from '../data/company';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  href?: string;
}
const {
  title = 'Připravujete stavbu nebo rekonstrukci?',
  text = 'Pošlete nám adresu a rozsah prací. Technik se vám ozve, zaměří stavbu a připraví cenovou nabídku – zdarma a nezávazně.',
  href = '/poptavka',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary btn--lg" href={href}>Nezávazně poptat lešení <Icon name="arrow" size={20} /></a>
      <a class="cta-band__phone" href={telHref(company.phone)}>
        <Icon name="phone" size={20} />
        <span>nebo volejte <strong>{company.phone}</strong></span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--c-yellow);
    color: var(--c-navy-900);
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .cta-band h2 {
    color: var(--c-navy-900);
    font-size: var(--fs-2xl);
  }
  .cta-band p {
    max-width: 40rem;
    margin: 0;
    font-size: var(--fs-md);
  }
  .cta-band__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 960px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-7);
    }
  }
  .cta-band__actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .cta-band .btn--primary {
    background: var(--c-navy-800);
    color: #fff;
  }
  .cta-band .btn--primary:hover {
    background: var(--c-navy-900);
    color: #fff;
  }
  .cta-band__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--c-navy-900);
  }
</style>
