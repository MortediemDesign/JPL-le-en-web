---
/**
 * Mapa se načte až po kliknutí (výkon + žádné cookies třetích stran bez akce uživatele).
 * Bez JS zůstává funkční odkaz do Google Map.
 */
import Icon from './Icon.astro';
interface Props {
  query: string;
  title: string;
}
const { query, title } = Astro.props;
const q = encodeURIComponent(query);
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${q}`;
const embed = `https://maps.google.com/maps?q=${q}&z=15&output=embed`;
---

<div class="map" data-map={embed} data-title={title}>
  <div class="map__placeholder">
    <Icon name="pin" size={32} />
    <p><strong>{query}</strong></p>
    <div class="btn-row">
      <button type="button" class="btn btn--secondary" data-map-load>Zobrazit mapu</button>
      <a class="btn btn--secondary" href={mapsLink} target="_blank" rel="noopener">
        Otevřít v Google Mapách<span class="visually-hidden"> (nové okno)</span>
      </a>
    </div>
    <p class="map__note">Po zobrazení mapy se načte obsah ze služby Google Maps.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.map!;
      iframe.title = box.dataset.title ?? 'Mapa';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .map {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background:
      repeating-linear-gradient(0deg, transparent 0 39px, #e3eaf4 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, #e3eaf4 39px 40px), #f7f9fc;
  }
  .map :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map__placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--c-navy-800);
  }
  .map__placeholder p {
    margin: 0;
  }
  .map__placeholder .btn-row {
    justify-content: center;
  }
  .map__note {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  @media (max-width: 480px) {
    .map {
      aspect-ratio: auto;
      min-height: 18rem;
    }
  }
</style>
