---
/**
 * Wordmark J.P.L. LEŠENÍ (SVG). TODO(klient): nahradit originálním logem ve vektoru –
 * současné logo je jen rastr z CMS (image.php?oid=6219583).
 */
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
const text = inverted ? '#ffffff' : '#0b2545';
---

<svg
  class="logo"
  viewBox="0 0 196 40"
  width="196"
  height="40"
  role="img"
  aria-label="J.P.L. LEŠENÍ"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="#f5b700" stroke-width="3" stroke-linecap="square" fill="none">
    <path d="M4 38V2M24 38V2M4 11h20M4 29h20M4 11l20 18" />
  </g>
  <text
    x="36"
    y="19"
    fill={text}
    font-family="system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif"
    font-size="17"
    font-weight="800"
    letter-spacing="0.5">J.P.L.</text
  >
  <text
    x="36"
    y="37"
    fill={text}
    font-family="system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif"
    font-size="17"
    font-weight="800"
    letter-spacing="2.4">LEŠENÍ</text
  >
</svg>

<style>
  .logo {
    height: 40px;
    width: auto;
  }
</style>
