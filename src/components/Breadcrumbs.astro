---
import type { Crumb } from '../lib/seo';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Drobečková navigace">
  <ol>
    {
      items.map((c, i) => (
        <li>
          {i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding: 0;
    margin: 0 0 var(--space-5);
    font-size: var(--fs-sm);
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .breadcrumbs li + li::before {
    content: '/';
    opacity: 0.6;
  }
  .breadcrumbs a {
    color: inherit;
  }
  .breadcrumbs span {
    overflow-wrap: anywhere;
  }
</style>
