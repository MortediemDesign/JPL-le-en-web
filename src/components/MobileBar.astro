---
/** Lepící lišta na mobilu – vždy dostupný telefon a poptávka. */
import { company, telHref } from '../data/company';
import Icon from './Icon.astro';
---

<div class="mobile-bar" aria-label="Rychlý kontakt" role="region">
  <a href={telHref(company.phone)} class="mobile-bar__call"><Icon name="phone" size={20} />Zavolat</a>
  <a href="/poptavka" class="mobile-bar__cta">Poptat lešení</a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    background: var(--c-surface);
    box-shadow: 0 -2px 12px rgb(7 26 51 / 0.15);
    padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom));
    gap: var(--space-2);
  }
  .mobile-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
  }
  .mobile-bar__call {
    border: 2px solid var(--c-navy-800);
    color: var(--c-navy-800);
  }
  .mobile-bar__cta {
    background: var(--c-yellow);
    color: var(--c-navy-900);
  }
  :global(html.menu-open) .mobile-bar {
    display: none;
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
