---
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import ReferenceCard from '../../components/ReferenceCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { references } from '../../data/references';

const breadcrumbs = [
  { label: 'Úvod', href: '/' },
  { label: 'Reference', href: '/reference' },
];

const categories = [
  { id: 'vse', label: 'Vše' },
  { id: 'pamatky', label: 'Památky a sakrální stavby', match: /Sakrální|Historick|areál/i },
  { id: 'budovy', label: 'Bytové a administrativní budovy', match: /Bytový|Administrativní|Obchodní|Divadel/i },
  { id: 'infrastruktura', label: 'Infrastruktura', match: /Most|Nádraž/i },
];
const catOf = (type: string) => categories.find((c) => c.match?.test(type))?.id ?? 'vse';
---

<BaseLayout
  title="Reference – realizace lešení | J.P.L. LEŠENÍ"
  description="Realizace J.P.L. LEŠENÍ: Staroměstská radnice, Jezuitský kostel Klatovy, ČSSZ Praha, Hlavní nádraží Plzeň, Karlovarské městské divadlo a další."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Reference"
    lead="Výběr zakázek, na kterých jsme stavěli lešení – od památek v centru Prahy po sakrální stavby, bytové domy a dopravní infrastrukturu."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrovat reference" data-filters hidden>
        {
          categories.map((c, i) => (
            <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c.id}>
              {c.label}
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>
      <ul class="grid grid--3 ref-list" role="list">
        {
          references.map((r, i) => (
            <li data-cat={catOf(r.objectType)}>
              <ReferenceCard reference={r} headingLevel="h2" eager={i < 3} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand title="Máte podobnou zakázku?" />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (bar) {
    bar.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('.ref-list > li')];
    bar.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const id = btn.dataset.filter!;
      bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      items.forEach((li) => {
        const show = id === 'vse' || li.dataset.cat === id;
        li.hidden = !show;
        if (show) n++;
      });
      if (status) status.textContent = `Zobrazeno ${n} referencí.`;
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .chip {
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: 999px;
    border: 2px solid var(--c-navy-800);
    background: transparent;
    color: var(--c-navy-800);
    font-weight: 700;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: var(--c-navy-800);
    color: #fff;
  }
  .ref-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ref-list > li {
    display: flex;
  }
  .ref-list > li[hidden] {
    display: none;
  }
  .ref-list :global(.ref-card) {
    flex: 1;
  }
</style>
